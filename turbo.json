{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["CRON_SECRET", "INVOICE_BLOB_READ_WRITE_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "BETTER_AUTH_ORIGINS",
        "RESEND_API_KEY",
        "JP_APP_URL",
        "JP_PORTAL_URL_ADMIN",
        "JP_PORTAL_URL_CUSTOMER",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_SID",
        "TWILIO_MESSAGING_SERVICE_SID",
        "TWILIO_FROM_NUMBER"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
