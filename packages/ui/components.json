{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-luma",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles/globals.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "bold",
  "aliases": {
    "components": "@jp/ui/components",
    "utils": "@jp/ui/lib/utils",
    "ui": "@jp/ui/components",
    "lib": "@jp/ui/lib",
    "hooks": "@jp/ui/hooks"
  },
  "registries": {
    "@magicui": "https://magicui.design/r/{name}",
    "@diceui": "https://diceui.com/r/{style}/{name}.json",
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@mapcn": "https://mapcn.dev/r/{name}.json"
  }
}
